---
import '../styles/global.css';
export interface Props { title?: string; description?: string; }
const {
  title = 'Lucien Pannatier · Head of IT & Information Security · Blue Team',
  description = 'Head of IT & Information Security and Blue Team engineer in Valais, Switzerland. Homelab tinkerer, open-source and self-hosting advocate, part-time photographer.'
} = Astro.props;
const site = Astro.site ?? new URL('https://lucienpannatier.ch');
const ogImage = new URL('/og.png', site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const year = new Date().getFullYear();
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Lucien Pannatier",
  "jobTitle": "Head of IT & Information Security",
  "worksFor": { "@type": "Organization", "name": "Croix-Rouge Valais" },
  "url": "https://lucienpannatier.ch",
  "address": { "@type": "PostalAddress", "addressRegion": "Valais", "addressCountry": "CH" },
  "knowsAbout": ["Blue Team", "Information Security", "Microsoft 365", "Systems Administration", "Data Governance"],
  "sameAs": ["https://infosec.exchange/@Bluewall", "https://github.com/Bluewal", "https://x.com/Bluewall"]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- html.js gates entrance animations; its sha256 is allow-listed in public/_headers (update both together) -->
<script is:inline>document.documentElement.classList.add('js')</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/JetBrainsMono-Medium.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/SpaceMono-Bold.woff2" as="font" type="font/woff2" crossorigin />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script is:inline src="/js/site.js" defer></script>
</head>
<body>
<header>
  <div class="wrap bar">
    <a href="/" class="brand"><span class="dot"></span>lucien@blueteam</a>
    <nav id="nav">
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navList">≡</button>
      <ul id="navList">
        <li><a href="/#about">about</a></li>
        <li><a href="/#skills">skills</a></li>
        <li><a href="/#career">career</a></li>
        <li><a href="/#credentials">credentials</a></li>
        <li><a href="/#projects">projects</a></li>
        <li><a href="/#photography">photography</a></li>
        <li><a href="/#contact">contact</a></li>
      </ul>
    </nav>
  </div>
</header>
<main>
<slot />
</main>
<footer>
  <div class="wrap foot">
    <div><span class="st">●</span> all systems operational · © <span id="year">{year}</span> Lucien Pannatier</div>
    <div>built static · deployed on Cloudflare Pages</div>
  </div>
</footer>
</body>
</html>
