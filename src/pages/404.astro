---
import Base from '../layouts/Base.astro';
---
<Base title="404 · Lucien Pannatier" description="Page not found.">
  <section class="section">
    <div class="wrap">
      <div class="eyebrow"><span class="tag warn">WARN</span><span class="prompt"><span class="u">$</span> cat ./this-page</span></div>
      <h2>404: no such file or directory</h2>
      <p class="lede">The page you asked for doesn't exist, or has moved.</p>
      <p class="back"><a href="/">&larr; back to the home page</a></p>
    </div>
  </section>
</Base>
