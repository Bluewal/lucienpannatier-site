      <a class="chan" href="https://x.com/Bluewall" target="_blank" rel="noopener"><span><span class="k">x.com</span><br><span class="v">@Bluewall</span></span><span class="arrow">→</span></a>
      <a class="chan" href="https://github.com/Bluewal" target="_blank" rel="noopener"><span><span class="k">github</span><br><span class="v">@Bluewal</span></span><span class="arrow">→</span></a>
      <a class="chan" href="mailto:contact@lucienpannatier.ch"><span><span class="k">email</span><br><span class="v">contact@lucienpannatier.ch</span></span><span class="arrow">→</span></a>
    </div>
  </div>
</section>
</Base>
