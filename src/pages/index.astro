---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { albums } from '../data/albums.js';

const files = import.meta.glob('../albums/**/*.{jpg,jpeg,png}', { eager: true });
const byAlbum = {};
for (const [p, m] of Object.entries(files)) {
  const slug = p.split('/').slice(-2)[0];
  (byAlbum[slug] ||= []).push({ p, img: m.default });
}
for (const s in byAlbum) byAlbum[s].sort((a, b) => a.p.localeCompare(b.p));
const gallery = albums.map(a => ({ ...a, cover: byAlbum[a.slug][0].img, count: byAlbum[a.slug].length }));
---
<Base>
<!-- HERO -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="wrap">
    <div class="console">
      <div class="console-top">
        <span class="lamp"></span><span class="lamp"></span><span class="lamp b"></span>
        <span class="path">~/lucien — zsh</span>
      </div>
      <div class="console-body">
        <div class="cmdline"><span class="u">lucien</span>@<span class="p">blueteam</span>:~$ <span id="typed"></span><span class="cursor" id="cursor"></span></div>
        <div class="idblock" id="idblock">
          <h1 class="name">Lucien Pannatier</h1>
          <div class="roles"><b>IT &amp; Security Lead</b> · <b>Blue Team</b> · <b>InfoSec</b> — Valais, Switzerland</div>
          <p class="tagline">Defender by trade. I build security posture from the ground up, break my own homelab for fun, and prefer things open-source and self-hosted. Photographer on the side.</p>
          <div class="statusbar">
            <div class="svc"><span class="st ok"></span><span class="lbl">status</span><span class="val">operational</span></div>
            <div class="svc"><span class="st on"></span><span class="lbl">homelab</span><span class="val">online</span></div>
            <div class="svc"><span class="st on"></span><span class="lbl">photography</span><span class="val">5 albums</span></div>
            <div class="svc"><span class="st ok"></span><span class="lbl">local</span><span class="val" id="clock">--:--:--</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="section" id="about">
  <div class="wrap reveal">
    <div class="eyebrow"><span class="tag info">INFO</span><span class="prompt"><span class="u">$</span> cat about.md</span></div>
    <h2>Whoami, the long version</h2>
    <div class="prose">
      <p>I've been hooked on technology since I was 13, spending long evenings teaching myself how computers actually work.</p>
      <p>After training as a <strong>Mediamatician</strong> with the Valais Cantonal Police, I took on a mandate from the State of Valais to migrate their land registry to a digital system — my first real-world migration under pressure.</p>
      <p>That led me to <strong>SKIDATA</strong>, the world leader in access systems, where I spent seven years as a Certified System Engineer: running database servers, deploying and configuring access systems for customers across the region, and doing QA on new products.</p>
      <p>Wanting broader ground, I joined <strong>CIGES</strong>, a local IT company running the infrastructure of several regional municipalities and two of Valais' largest energy providers — helpdesk, workplace support, and teaching entry-level InfoSec.</p>
      <p>Today I'm <strong>IT &amp; Security Lead</strong> at <strong>Croix-Rouge Valais</strong>, where I run IT and own the security posture. I lean <strong>Blue Team</strong>: hardening, monitoring, incident response — turning inherited environments into something actually defensible.</p>
      <p>Off the clock: a self-hosted homelab that mirrors how I work, plus cooking, photography, and (too many) video games.</p>
    </div>
  </div>
</section>

<!-- SKILLS -->
