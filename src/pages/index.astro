<!-- PROJECTS -->
<section class="section" id="projects">
  <div class="wrap reveal">
    <div class="eyebrow"><span class="tag info">INFO</span><span class="prompt"><span class="u">$</span> systemctl status lab</span></div>
    <h2>Projects &amp; lab</h2>
    <p class="lede">A few things I build and run in the open. <span class="comment" style="color:var(--fg-dim)">draft descriptions — tweak the wording as you like</span></p>
