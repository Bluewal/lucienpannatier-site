<section class="section" id="photography">
  <div class="wrap reveal">
    <div class="eyebrow"><span class="tag info">INFO</span><span class="prompt"><span class="u">$</span> ls ~/photography/</span></div>
    <h2>Photography</h2>
    <p class="lede">Five sets, shot across Switzerland and beyond. Click an album to open the gallery.</p>
    <div class="grid gallery">
      {gallery.map(a => (
        <a class="album" href={`/albums/${a.slug}`}>
          <div class="art"><Picture src={a.cover} formats={['avif','webp']} widths={[400, 800]} sizes="(max-width: 700px) 90vw, 30vw" alt={a.title} /></div>
          <div class="meta"><div class="name">{a.title}</div><div class="sub"><span class="y">{a.count} photos</span><span>&middot;</span><span>view album &rarr;</span></div></div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="section" id="contact">
