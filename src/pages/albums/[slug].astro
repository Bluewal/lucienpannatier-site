---
import Base from '../../layouts/Base.astro';
import { Picture, getImage } from 'astro:assets';
import { albums } from '../../data/albums.js';

export async function getStaticPaths() {
  const files = import.meta.glob('../../albums/**/*.{jpg,jpeg,png}', { eager: true });
  const byAlbum = {};
  for (const [p, m] of Object.entries(files)) {
    const slug = p.split('/').slice(-2)[0];
    (byAlbum[slug] ||= []).push({ p, img: m.default });
  }
  for (const s in byAlbum) byAlbum[s].sort((a, b) => a.p.localeCompare(b.p));
  return albums.map(a => ({ params: { slug: a.slug }, props: { album: a, images: (byAlbum[a.slug] || []).map(x => x.img) } }));
}

const { album, images } = Astro.props;
const fulls = await Promise.all(images.map(img => getImage({ src: img, width: 2200, format: 'webp', quality: 82 })));
---
<Base title={`${album.title} · Lucien Pannatier`} description={`Photography · ${album.title}, by Lucien Pannatier.`}>
  <section class="section">
    <div class="wrap">
      <div class="eyebrow"><span class="tag info">INFO</span><span class="prompt"><span class="u">$</span> ls ~/photography/{album.slug}/</span></div>
      <h2>{album.title}</h2>
      <p class="lede back"><a href="/#photography">&larr; back to all albums</a></p>
      <div class="masonry">
        {images.map((img, i) => (
          <a class="ph" href={fulls[i].src} data-full={fulls[i].src} aria-label={`${album.title} photo ${i + 1}`}>
            <Picture src={img} formats={['avif','webp']} widths={[400, 800, 1200]} sizes="(max-width: 700px) 45vw, 30vw" alt={`${album.title} ${i + 1}`} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <div id="lb" class="lb" aria-hidden="true">
    <button class="lb-close" aria-label="Close">✕</button>
    <button class="lb-prev" aria-label="Previous">‹</button>
    <img id="lb-img" alt="" />
    <button class="lb-next" aria-label="Next">›</button>
  </div>
</Base>
